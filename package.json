{
  "name": "dsh-plugin-tiles",
  "version": "0.1.0",
  "description": "一排小方块：一个方块 = 一个装过的插件，左键开关、右键改名，尺寸可调。附全量清单与待重启标记。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "plugin-manager", "toggle"],
  "author": "zydxn77",
  "repository": {
    "type": "git",
    "url": "https://github.com/zydxn77/dsh-plugin-tiles"
  },
  "homepage": "https://github.com/zydxn77/dsh-plugin-tiles#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "license": "MIT"
}
